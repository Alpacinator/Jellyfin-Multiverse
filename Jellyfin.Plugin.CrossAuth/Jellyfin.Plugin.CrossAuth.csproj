<Project Sdk="Microsoft.NET.Sdk">

  <!--
    PROJECT FILE
    Tells the compiler how to build the plugin.
    - Targets .NET 10 and Jellyfin 12.1 (the minimum supported server version).
      Jellyfin 12 only ships its packages for net10.0, so older servers cannot load this plugin.
    - ImplicitUsings means common namespaces (System, System.Linq, ...) are added automatically.
    - The .html files in the Web folder are embedded INSIDE the dll, so the plugin is a single file.
  -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Jellyfin.Plugin.CrossAuth</RootNamespace>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Jellyfin.Controller" Version="12.1.0" />
    <PackageReference Include="Jellyfin.Model" Version="12.1.0" />
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Web\*.html" />
  </ItemGroup>

</Project>
